# EduWatch Environment Configuration Example

# Active SQLite database for zero-config local run:
DATABASE_URL="file:./dev.db"

# Production PostgreSQL Database URL:
# DATABASE_URL="postgresql://username:password@localhost:5432/eduwatch?schema=public"

PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-secure-random-secret-key-in-production
CORS_ORIGIN=http://localhost:5173
